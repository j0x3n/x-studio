{
  "说明": "主图和详情页每个位置可用哪些照片编号，按优先级排，前面的有就用前面的。编号含义见 运营/淘宝商品拍摄清单.md；E5 = 散珠或成品托盘实拍（不修图），C4_<尺寸> = 同一只耳朵戴各个尺寸，上游拍摄要求见 出图网站/README.md。必需=true 的位置缺了要提醒补拍，不能用 AI 生成。AI 补的图编号带 _AI 后缀（A1_AI、E1_AI、E2_AI、E3_AI），只能命中候选里有 A1、E1、E2、E3 的位置（首图、首屏、白底）；其余位置只认实拍和只做了高清化的图。",
  "主图": [
    {"位": 1, "名": "首图", "候选": ["D4", "D1", "D2", "D3", "E1", "E2", "E3"], "必需": true, "备注": "优先上耳实拍；没有上耳就用场景图"},
    {"位": 2, "名": "批量实拍", "候选": ["E5"], "必需": false, "备注": "手托托盘，同款多对一起拍，原相机"},
    {"位": 3, "名": "微距光泽", "候选": ["B1", "B2"], "必需": true},
    {"位": 4, "名": "尺寸", "候选": ["C4", "C1", "C2", "C3"], "必需": true, "备注": "C4_<尺寸>.jpg = 同一只耳朵分别戴各个尺寸，每个尺寸一张，如 C4_8mm.jpg；C4 指这一组"},
    {"位": 5, "名": "规格或礼盒", "候选": ["A3", "F2", "F1", "E4"], "必需": false},
    {"位": "白底", "名": "白底图", "候选": ["A1", "A2"], "必需": true, "备注": "需要修图脚本生成 _白底 版本"}
  ],
  "详情页": [
    {"屏": 1, "名": "首屏", "候选": ["E1", "E2", "E3", "D4", "D1", "D2", "F2", "E4", "B2"], "必需": true},
    {"屏": 2, "名": "真假珍珠", "候选": ["E5", "B1"], "必需": true},
    {"屏": 3, "名": "细节", "候选": ["B2", "B3", "B4", "B5", "B6"], "必需": false, "最少": 1},
    {"屏": 4, "名": "上耳", "候选": ["D1", "D2", "D3", "D4", "D5"], "必需": false},
    {"屏": 5, "名": "尺寸", "候选": ["C4", "C1", "C2", "C3"], "必需": true},
    {"屏": 7, "名": "包装", "候选": ["F2", "F1", "E4"], "必需": false}
  ]
}
