# 服务器部署目录里的 .env。第一次自动部署时 remote-deploy.sh 会生成一份，之后在服务器上改。
# 域名要先解析到这台服务器
XS_DOMAIN=studio.example.com
# 程序在服务器本机监听的端口，反向代理指向 127.0.0.1:这个端口
XS_PORT=17390
# 自动部署会写入具体版本
# XS_IMAGE=ghcr.io/j0x3n/x-studio:sha-xxxxxxx

# 至少 32 字符，生成：openssl rand -hex 32
SESSION_SECRET=
ADMIN_USER=admin
# 首次启动时建管理员用；建好后改不改都行
ADMIN_PASSWORD=
COOKIE_SECURE=1
TZ=Asia/Shanghai

AI_BASE_URL=https://subapi.xcc.im/v1
AI_API_KEY=
AI_MODEL_VISION=gpt-6-sol
AI_MODEL_TEXT=gpt-6-sol
AI_REASONING_EFFORT=medium
IMAGE_MODEL=gpt-image-2.5-burst
IMAGE_TIMEOUT=240
WORKERS=2

# 服务器上没有反向代理时取消下一行的注释，使用自带的 Caddy
# COMPOSE_PROFILES=caddy
